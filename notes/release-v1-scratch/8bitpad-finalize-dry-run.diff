+  finalize-dry-run:
+    # Proves the release inventory on any branch without a tag or a write token.
+    needs: native
+    if: github.event_name == 'workflow_dispatch' && inputs.finalize_dry_run && inputs.packages
+    runs-on: ubuntu-22.04
+    permissions: { contents: read }
