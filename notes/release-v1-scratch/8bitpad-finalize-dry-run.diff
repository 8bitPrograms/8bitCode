         description: Prepare a draft for a matching version tag
         type: boolean
         default: false
+      finalize_dry_run:
+        description: Run release-check and finalize on the package candidates; never creates a release
+        type: boolean
+        default: false
 env:
   PYTHONUTF8: '1'
 permissions:
@@ -281,3 +285,26 @@ jobs:
         run: |
           version=$(python scripts/ci/distribution.py version)
